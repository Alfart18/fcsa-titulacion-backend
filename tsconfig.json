{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "composite": true,
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/database": [
        "./libs/database/src"
      ],
      "@app/database/*": [
        "./libs/database/src/*"
      ]
    }
  },

  "include": ["src/**/*", "prisma/**/*", "apps/**/*", "libs/**/*"],

  "files": [],
  "references": [
    {
      "path": "./apps/fcsa-titulacion-backend/tsconfig.app.json"
    },
    {
      "path": "./apps/identidad-service/tsconfig.app.json"
    }
  ]
}