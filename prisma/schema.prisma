generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  DECANO
  SECRETARIA_ACADEMICA
  ADMINISTRATIVO
}

enum EstadoUsuario {
  ACTIVO
  DESACTIVADO
}

enum EstadoDocente {
  ACTIVO
  INACTIVO
}

model ConfiguracionInstitucional {
  id                Int      @id @default(autoincrement())
  facultad          String   @default("Facultad de Ciencias de la Salud") @db.VarChar(200)
  universidad       String   @default("Universidad Andina del Cusco") @db.VarChar(200)
  ciudad            String   @default("Cusco") @db.VarChar(100)
  siglasFacultad    String   @default("FCSa") @map("siglas_facultad") @db.VarChar(20)
  siglasUniversidad String   @default("UAC") @map("siglas_universidad") @db.VarChar(20)
  actualizadoEn     DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_institucional")
}

model Usuario {
  id               String              @id @default(uuid()) @db.Uuid
  nombresCompletos String              @map("nombres_completos") @db.VarChar(180)
  gradoTitulo      String              @default("Dr.") @map("grado_titulo") @db.VarChar(50)
  correo           String              @unique @db.VarChar(150)
  passwordHash     String              @map("password_hash")
  iniciales        String              @db.VarChar(10)
  rol              RolUsuario
  estado           EstadoUsuario       @default(ACTIVO)
  esDecanoFirmante Boolean             @default(false) @map("es_decano_firmante")
  creadoEn         DateTime            @default(now()) @map("creado_en")
  actualizadoEn    DateTime            @updatedAt @map("actualizado_en")
  auditorias       RegistroAuditoria[]

  @@map("usuarios")
}

model DepartamentoAcademico {
  id       Int                  @id @default(autoincrement())
  nombre   String               @unique @db.VarChar(180)
  activo   Boolean              @default(true)
  escuelas EscuelaProfesional[]
  docentes Docente[]

  @@map("departamentos_academicos")
}

model EscuelaProfesional {
  id                    Int                   @id @default(autoincrement())
  nombre                String                @unique @db.VarChar(180)
  gradoBachiller        String                @map("grado_bachiller") @db.VarChar(200)
  tituloProfesional     String                @map("titulo_profesional") @db.VarChar(220)
  departamentoDefectoId Int                   @map("departamento_defecto_id")
  departamentoDefecto   DepartamentoAcademico @relation(fields: [departamentoDefectoId], references: [id])
  activa                Boolean               @default(true)
  docentes              Docente[]

  @@map("escuelas_profesionales")
}

model Docente {
  id                      String                @id @default(uuid()) @db.Uuid
  gradoAcademico          String                @map("grado_academico") @db.VarChar(30)
  nombresCompletos        String                @map("nombres_completos") @db.VarChar(200)
  correo                  String                @unique @db.VarChar(150)
  departamentoAcademicoId Int                   @map("departamento_academico_id")
  departamentoAcademico   DepartamentoAcademico @relation(fields: [departamentoAcademicoId], references: [id])
  escuelaProfesionalId    Int                   @map("escuela_profesional_id")
  escuelaProfesional      EscuelaProfesional    @relation(fields: [escuelaProfesionalId], references: [id])
  estado                  EstadoDocente         @default(ACTIVO)
  creadoEn                DateTime              @default(now()) @map("creado_en")
  actualizadoEn           DateTime              @updatedAt @map("actualizado_en")

  @@map("docentes")
}

model RegistroAuditoria {
  id               BigInt   @id @default(autoincrement())
  usuarioId        String   @map("usuario_id") @db.Uuid
  usuario          Usuario  @relation(fields: [usuarioId], references: [id])
  inicialesUsuario String   @map("iniciales_usuario") @db.VarChar(10)
  accion           String   @db.VarChar(50)
  entidad          String   @db.VarChar(60)
  entidadId        String?  @map("entidad_id") @db.VarChar(80)
  detalle          Json
  fechaHora        DateTime @default(now()) @map("fecha_hora")

  @@map("registro_auditoria")
}